# Local-only example values. Production needs explicit reviewed policy and provider credentials.
NODE_ENV=development
PROVIDER_MODE=local
DATABASE_URL=postgres://together_runtime:localruntime@127.0.0.1:54328/together_dev
MIGRATION_DATABASE_URL=postgres://postgres:localdev@127.0.0.1:54328/together_dev
TEST_DATABASE_URL=postgres://postgres:localdev@127.0.0.1:54328/together_test
LOCAL_MEDIA_DIR=.local/media
AUTH_CALLBACK_URL=http://127.0.0.1:3000/v1/auth/callback
FREE_GROUP_CAPACITY=5
PAID_GROUP_CAPACITY=10
FREE_ACTIVE_CHALLENGES=2
PAID_ACTIVE_CHALLENGES=5
MAX_IMAGE_BYTES=1048576
MAX_ATTACHMENTS_PER_SUBMISSION=3
BILLING_MODE=test
REVENUECAT_ENVIRONMENT=sandbox
PORT=3000
# For later Supabase use: PROVIDER_MODE=supabase, set these and disable its Data API.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
# STORAGE_BUCKET=proof-private
# For later live billing: BILLING_MODE=revenuecat and set these.
# REVENUECAT_WEBHOOK_SECRET=
# REVENUECAT_API_KEY=
# REVENUECAT_PROJECT_ID=
