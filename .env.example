# Runtime role: only DML privileges on application tables; separate from migration role.
DATABASE_URL=postgres://together_runtime:replace-me@127.0.0.1:5432/together_dev
MIGRATION_DATABASE_URL=postgres://together_migrate:replace-me@127.0.0.1:5432/together_dev
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_KEY=replace-me
STORAGE_BUCKET=proof-private
AUTH_CALLBACK_URL=http://localhost:3000/v1/auth/callback
FREE_GROUP_CAPACITY=5
PAID_GROUP_CAPACITY=10
FREE_ACTIVE_CHALLENGES=2
PAID_ACTIVE_CHALLENGES=5
MAX_IMAGE_BYTES=1048576
MAX_ATTACHMENTS_PER_SUBMISSION=3
BILLING_MODE=test
REVENUECAT_ENVIRONMENT=sandbox
# Required only when BILLING_MODE=revenuecat:
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=
REVENUECAT_PROJECT_ID=
PORT=3000
