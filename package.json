{
  "name": "together-be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts src/worker.ts --target=bun --outdir=dist",
    "start": "bun src/index.ts",
    "worker": "bun src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts drizzle.config.ts",
    "format": "biome format --write src test scripts drizzle.config.ts",
    "format:check": "biome format src test scripts drizzle.config.ts",
    "test": "bun test",
    "test:supabase": "bun scripts/supabase-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun src/db/seed.ts",
    "api:generate": "bun src/generate-openapi.ts"
  },
  "dependencies": {
    "@elysia/openapi": "1.4.15",
    "drizzle-orm": "0.45.3",
    "elysia": "1.4.30",
    "postgres": "3.4.9",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3"
  }
}
